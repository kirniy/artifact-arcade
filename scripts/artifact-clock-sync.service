[Unit]
Description=ARTIFACT HTTPS clock fallback when NTP is unreachable
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/artifact-clock-sync.py
TimeoutStartSec=40
User=root
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_TIME
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
